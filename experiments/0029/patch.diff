+def _retry_draft(model, cache, slot, remaining):
+    """Admit one positional retry using only host IDs and cache metadata."""
+    if slot is None or not cache:
+        return []
+    offset, pending_id, retained = slot
+    if (cache[0].offset != offset or len(cache.history) != offset + 1
+            or cache.history[-1] != pending_id
