+        history = list(cache.history)
+        assert cache.match() == context
+        assert ci._draft(cache, 2 if reason == "budget" else 8) == [draft], reason
+        assert ci._draft(cache, 1) == []
+        assert cache.history == history and cache[0].offset == c
