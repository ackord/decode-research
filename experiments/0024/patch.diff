+def _retrieval_native_checks(model):
+    """Real feature retrieval, native logits/KV, rollback and decode transitions."""
+    for k in (2, 3, 4):
+        prompt = [1] + [100 + i for i in range(23)]
+        prompt[len(prompt) - k] = 41  # Only eligible matching anchor.
+        _, base = ci.prefill(model, prompt)
