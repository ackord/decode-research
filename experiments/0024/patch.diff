+def _retrieval_selection_checks():
+    """Synthetic features isolate indexing, validity and eligibility gates."""
+    def fixture(c=12, anchors=(3, 8, 10), capacity=None):
+        history = list(range(100, 101 + c))
+        history[c] = 7
+        for j in anchors:
+            history[j] = 7
+        kv = KVCache()
+        kv.offset = c
+        size = c + 5 if capacity is None else capacity
+        kv.keys = mx.zeros((1, 3, size, 64), dtype=mx.bfloat16)
+        kv.values = mx.full((1, 3, size, 64), float("nan"), dtype=mx.bfloat16)
+        cache = ci.RequestCache([kv], history)
+        cache.batch_rows_eligible = cache.grouped_eligible = True
+        return cache
+
+    def feature(cache, i, values):
+        cache[-1].values[0, :, i, :] = mx.array(values, dtype=mx.bfloat16).reshape(3, 64)
+
+    def select(cache, anchor, remaining=9):
+        actual = ci._retrieve(None, cache, remaining)
+        c = cache[0].offset
+        d = min(4, remaining - 1,
+                min(min(k.keys.shape[2], k.values.shape[2]) for k in cache) - c - 1)
+        expected = [] if anchor is None else cache.history[anchor + 1:anchor + 1 + min(d, c - anchor)]
+        assert actual == expected, (actual, expected)
+
+    # Head order is observable: each head has a different nonzero coordinate.
+    query = [0.0] * 192
+    for i, v in ((0, 1), (65, 2), (130, 3)):
+        query[i] = v
+    cache = fixture()
+    feature(cache, 11, query)
+    feature(cache, 2, query)
+    feature(cache, 7, query[64:] + query[:64])
+    feature(cache, 9, [-v for v in query])
+    select(cache, 3)
+    assert cache.stats["retrieval_attempts"] == 1
+    # Identical scores choose the most recent eligible anchor, with exactly
+    # two observed successors (including the committed pending token).
+    feature(cache, 9, query)
+    select(cache, 10)
+    feature(cache, 2, [-v for v in query])
+    feature(cache, 7, [-v for v in query])
+    feature(cache, 9, [-v for v in query])
+    select(cache, 10)  # Negative scores must remain eligible.
+    for bad in (0.0, float("nan"), float("inf"), 1e30):
+        for i in (2, 7, 9):
+            feature(cache, i, [bad] * 192)
+        select(cache, None)
+        feature(cache, 9, query)
+        select(cache, 10)  # Invalid rows cannot mask a valid comparison.
+        feature(cache, 11, [bad] * 192)
+        select(cache, None)
+        feature(cache, 11, query)
+
+    # Both inclusive window endpoints; j=0 and j=C-1 are excluded. The
+    # allocated tail and unused predecessor rows remain poisoned throughout.
+    cache = fixture(4100, (0, 3, 4, 4098, 4099))
+    feature(cache, 4099, query)
+    feature(cache, 3, query)
+    feature(cache, 4097, [-v for v in query])
+    select(cache, 4)
+    feature(cache, 3, [-v for v in query])
+    feature(cache, 4097, query)
+    select(cache, 4098)
+    cache = fixture(3, (1,))
+    feature(cache, 2, query)
+    feature(cache, 0, query)
+    select(cache, 1)
+    cache = fixture(2, (0, 1))
+    select(cache, None)
+    assert cache.stats["retrieval_attempts"] == 0
+    cache = fixture(12, ())
+    select(cache, None)
+    assert cache.stats["retrieval_attempts"] == 0
+
+    cache = fixture()
+    feature(cache, 11, query)
+    feature(cache, 9, query)
+    for remaining in (0, 1, 2):
+        select(cache, None, remaining)
+    for remaining in (3, 4, 5):
+        select(cache, 10, remaining)
+    # Unequal capacities must use the smaller buffer, including in layers
