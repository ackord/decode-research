+def _retrieve(model, cache, remaining):
+    """Select observed successors using only committed predecessor values."""
+    if not cache or remaining < 3:
+        return []
+    c = cache[0].offset
+    if (len(cache.history) != c + 1
+            or any(kv.offset != c or kv.keys is None or kv.values is None
+                   or kv.keys.ndim != 4 or kv.values.ndim != 4 for kv in cache)):
+        return []
+    capacity = min(min(kv.keys.shape[2], kv.values.shape[2]) for kv in cache)
+    d = min(4, remaining - 1, capacity - c - 1)
+    if d < 2 or _bulk_start(cache, d + 1) != c:
+        return []
+    if not _block_eligibility(model, cache, c, d + 1)[1]:
+        return []
+    history = cache.history
+    # Descending anchors make argmax's first-index tie rule prefer recency.
+    anchors = [j for j in range(c - 2, max(1, c - 4096) - 1, -1)
+               if history[j] == history[c]]
+    if not anchors:
+        return []
+    cache.stats["retrieval_attempts"] += 1
+    indices = mx.array(anchors, dtype=mx.int32)
+    values = cache[-1].values
+    # Gather in head-major storage, then transpose to token/head/dimension.
+    rows = mx.take(values[0], indices - 1, axis=1).transpose(1, 0, 2)
+    rows = rows.reshape(len(anchors), 192).astype(mx.float32)
+    query = values[0, :, c - 1, :].reshape(192).astype(mx.float32)
+    row_norms = mx.sum(rows * rows, axis=1)
+    query_norm = mx.sum(query * query)
+    valid_rows = mx.isfinite(row_norms) & (row_norms > 0)
+    valid_query = mx.isfinite(query_norm) & (query_norm > 0)
+    rows = rows / mx.sqrt(mx.where(valid_rows, row_norms, 1))[:, None]
+    query = query / mx.sqrt(mx.where(valid_query, query_norm, 1))
+    scores = mx.sum(rows * query[None], axis=1)
+    valid = valid_rows & valid_query & mx.isfinite(scores)
+    scores = mx.where(valid, scores, -float("inf"))
+    winner = mx.where(mx.any(valid), indices[mx.argmax(scores)], -1)
+    anchor = winner.item()  # Exactly one scalar read; no feature store survives.
+    if anchor < 0:
+        return []
+    k = min(d, c - anchor)
+    return history[anchor + 1:anchor + 1 + k]
+
