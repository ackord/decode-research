+        assert active.stats["accepted_retrieved_tokens"] <= active.stats["retrieved_tokens"]
+        _prefixes(active, oracle_cache, f"active retrieval decode/k{k}")
+        # Ordinary multi-token drafts bypass retrieval entirely.
+        preserved = _clone(model, base)
+        with patch.object(ci, "_draft", return_value=oracle[1:3]), \
+             patch.object(ci, "_retrieve", side_effect=AssertionError("ordinary draft replaced")):
+            assert ci.decode(model, pending, preserved, 4) == oracle[:4]
+        assert preserved.stats["retrieval_attempts"] == 0
+
