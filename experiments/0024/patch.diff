+def _retrieval_transition_checks():
+    """Controlled predictions exercise every acceptance length through decode.
+
+    Retrieval is real; only target forwards are replaced by a position oracle.
+    Native target math is checked separately by _retrieval_native_checks.
+    """
+    def run(prompt, oracle, expected_blocks, expected_accepted, ordinary=()):
+        class Target:
+            def __call__(self, token, cache):
+                position = cache[0].offset
+                # Cache content depends on the input as well as position, so
+                # rejected speculative inputs must be overwritten correctly.
+                value = token.reshape(1, 1, 1, 1).astype(mx.bfloat16)
+                features = mx.broadcast_to(value + position, (1, 3, 1, 64))
+                for kv in cache:
+                    kv.update_and_fetch(features, features)
+                logits = mx.full((1, 1, 2048), -1.0)
+                logits[0, 0, oracle[position - len(prompt) + 1]] = 1.0
+                return logits
+
+        def fresh():
+            kv = KVCache()
+            kv.offset = len(prompt)
+            capacity = len(prompt) + (10 if expected_blocks == 2 else 5)
+            kv.keys = mx.full((1, 3, capacity, 64), float("nan"), dtype=mx.bfloat16)
+            kv.values = mx.asarray(kv.keys, copy=True)
+            for i, token in enumerate(prompt):
+                kv.keys[..., i, :] = token + i
+                kv.values[..., i, :] = token + i
+            state = ci.RequestCache([kv], prompt)
+            state.batch_rows_eligible = state.grouped_eligible = True
+            return state
+
+        target, active, reference = Target(), fresh(), fresh()
+        first = mx.array([oracle[0]])
+        token = first
+        for expected in oracle[1:]:
+            logits = target(token, cache=reference)
+            token = mx.argmax(logits[:, -1, :], axis=-1)
+            assert token.item() == expected
+
+        def verify(model, cache, tokens):
+            return [mx.argmax(model(t, cache=cache)[:, -1, :], axis=-1) for t in tokens]
+
+        with patch.object(ci, "_supported", return_value=True), \
+             patch.object(ci, "_draft", return_value=list(ordinary)), \
+             patch.object(ci, "_verify", verify):
+            assert ci.decode(target, first, active, len(oracle)) == oracle
+        assert active.stats["retrieved_blocks"] == expected_blocks
+        assert active.stats["accepted_retrieved_tokens"] == expected_accepted, active.stats
+        _prefixes(active, reference, "controlled retrieval transitions")
+        assert all(kv.offset == len(prompt) + len(oracle) - 1 for kv in active)
+        assert active.head_panels is None
+        assert fresh().stats["retrieval_attempts"] == 0
+
+    for k in (2, 3, 4):
+        prompt = [100 + i for i in range(24)]
+        prompt[24 - k] = 41
+        observed = prompt[25 - k:] + [41]
