+        drained.append_token(41)
+        drafts = ci._retrieve(model, drained, 16)
+        assert drafts == drained.history[len(prompt) - k + 1:]
+        assert len(drafts) == k and drained.stats["retrieval_attempts"] == 1
+        tokens = [pending.reshape(1, 1)] + [mx.array([[d]]) for d in drafts]
+        g, r = _clone(model, drained), _clone(model, base)
+        trace = []
+        predictions = ci._verify(model, g, tokens, _trace=trace)
+        reference_logits = [model(t, cache=r) for t in tokens]
+        mx.eval(*predictions, *reference_logits)
+        for i, (a, b) in enumerate(zip(dict(trace)["logits"], reference_logits)):
+            _equal(a, b, f"retrieved logits/k{k}/row{i}")
+        _prefixes(g, r, f"retrieved verifier/k{k}")
+        for accepted in range(k + 1):
+            gc, rc = _clone(model, g, len(prompt) + k + 1), _clone(model, r, len(prompt) + k + 1)
+            for kv in [*gc, *rc]:
+                kv.trim(k - accepted)
+            token = predictions[accepted].reshape(1, 1)
+            for step in range(k + 2):
+                gl, rl = model(token, cache=gc), model(token, cache=rc)
+                _equal(gl, rl, f"retrieved rollback/k{k}/a{accepted}/step{step}")
+                token = mx.argmax(rl[:, -1, :], axis=-1).reshape(1, 1)
+            _prefixes(gc, rc, f"retrieved rollback growth/k{k}/a{accepted}")
+
+        oracle_cache = _clone(model, base)
+        token, oracle = pending, [41]
+        for _ in range(15):
+            logits = model(token.reshape(1, 1), cache=oracle_cache)
+            token = mx.argmax(logits[:, -1, :], axis=-1)
+            oracle.append(token.item())
