+"""Outward weight metadata; no model or request computation is cached here."""
+
+import numpy as np
+
+
+def up(x):
+    return np.nextafter(np.asarray(x, dtype=np.float64), np.inf)
+
+
+def down(x):
+    return np.nextafter(np.asarray(x, dtype=np.float64), -np.inf)
+
+
+def gamma(n, precision=24):
+    # n*u is exact for the dimensions used here; division is rounded outward.
+    nu = n * 2.0 ** -precision
+    return up(nu / (1.0 - nu))
+
+
+def norm_upper(x):
+    """Nonnegative squares, reduction, and square root, each enclosed.
+
+    Any sum ordering has at most d-1 additions along a path. Subnormal
+    FP64 additions are exact; individual underflowing squares are covered
+    by nextafter. This is more than a final upward rounding of a norm.
+    """
+    squares = up(np.asarray(x, dtype=np.float64) ** 2)
+    total = up(np.sum(squares, axis=-1) / down(1.0 - gamma(x.shape[-1], 53)))
+    return up(np.sqrt(total))
+
+
+def supported_range(x):
+    a = np.abs(x)
+    return bool(np.all(np.isfinite(a) & (a <= 2.0**16)
+                       & ((a == 0) | (a >= 2.0**-64))))
+
+
+def float32_upper(x):
+    # Conversion itself may round down; another FP32 successor encloses it.
+    return np.nextafter(np.asarray(x, dtype=np.float32), np.float32(np.inf))
+
+
+def coefficients(weights, codes, scales, biases):
+    """Return R + gamma_aux*A + gamma_ref*S and 2*gamma_ref*S.
+
+    Reconstruction is defined by the stored parameters, not dequantize().
+    Every arithmetic operation used to construct R, S, A is enclosed.
+    """
+    d = weights.shape[-1]
+    w = np.asarray(weights, dtype=np.float64)
+    s = np.repeat(np.asarray(scales, dtype=np.float64), 64, axis=-1)
+    b = np.repeat(np.asarray(biases, dtype=np.float64), 64, axis=-1)
+    sq_lo, sq_hi = down(s * codes), up(s * codes)
+    lo, hi = down(sq_lo + b), up(sq_hi + b)
+    residual = up(np.maximum(np.abs(w - lo), np.abs(w - hi)))
+    magnitude = up(np.maximum(np.abs(sq_lo), np.abs(sq_hi)) + np.abs(b))
+    r, a, s_norm = norm_upper(residual), norm_upper(magnitude), norm_upper(w)
+    ref = up(gamma(2 * d) * s_norm)
+    aux = up(gamma(8 * d + 32) * a)
+    coarse = up(up(r + aux) + ref)
+    return float32_upper(coarse), float32_upper(up(2 * ref))
