diff --git a/candidate/test_certified_head.py b/candidate/test_certified_head.py
new file mode 100644
index 0000000..944453f
--- /dev/null
+++ b/candidate/test_certified_head.py
@@ -0,0 +1,170 @@
+"""Independent synthetic checks; run with python -m unittest candidate.test_certified_head."""
+
+from decimal import Decimal, localcontext
+import unittest
+from unittest.mock import patch
+
+import numpy as np
+
+from ._bounds import coefficients, norm_upper, supported_range
+
+
+class MetadataTests(unittest.TestCase):
+    def test_norm_encloses_high_precision_sum(self):
+        with localcontext() as context:
+            context.prec = 120
+            for x in (np.zeros(576), np.full(576, 2.0**-64),
+                      np.geomspace(2.0**-64, 2.0**16, 576)):
+                exact = sum(Decimal(float(v)) ** 2 for v in x).sqrt()
+                self.assertGreaterEqual(Decimal(float(norm_upper(x))), exact)
+
+    def test_stored_affine_cancellation_is_enclosed(self):
+        # Reconstruction is near zero although its two affine terms are large.
+        codes = np.full((2, 576), 15, dtype=np.uint32)
+        scales = np.full((2, 9), 128, dtype=np.float32)
+        biases = np.full((2, 9), -1920, dtype=np.float32)
+        weights = np.full((2, 576), 2.0**-20, dtype=np.float32)
+        coarse, refined = coefficients(weights, codes, scales, biases)
+        self.assertTrue(np.all(np.isfinite(coarse)))
+        self.assertTrue(np.all(coarse > 1))  # Cancellation must NOT shrink A.
+        self.assertTrue(np.all(refined > 0))
+
+    def test_range_contract(self):
+        self.assertTrue(supported_range(np.array([0, -2.0**-64, 2.0**16])))
+        for x in (np.nan, np.inf, 2.0**17, 2.0**-65):
+            self.assertFalse(supported_range(np.array([x])))
+
+
+def load_runtime():
+    # Import failure is an execution-environment limitation, not a result.
+    try:
+        import mlx.core as mx
+        from . import certified_head as ch
+        from mlx_lm.models.llama import Model, ModelArgs
+    except ImportError as error:
+        raise unittest.SkipTest(str(error))
+    if not ch.arithmetic_supported():
+        raise unittest.SkipTest("Stock arithmetic adapter unavailable")
+    return mx, ch, Model, ModelArgs
+
+
+class RuntimeTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.mx, cls.ch, cls.Model, cls.ModelArgs = load_runtime()
+
+    def make_model(self, weights):
+        mx = self.mx
+        model = self.Model(self.ModelArgs(
+            model_type="llama", hidden_size=weights.shape[1],
+            intermediate_size=weights.shape[1] * 2, num_hidden_layers=1,
+            num_attention_heads=4, rms_norm_eps=1e-5, vocab_size=len(weights)))
+        model.set_dtype(mx.bfloat16)
+        model.model.embed_tokens.weight = mx.array(weights).astype(mx.bfloat16)
+        return model
+
+    def test_every_row_interval_contains_stock_projection(self):
+        mx, ch = self.mx, self.ch
+        rng = np.random.default_rng(917)
+        weights = rng.normal(0, 0.1, (512, 576)).astype(np.float32)
+        # Identical, zero, and cancellation-heavy rows independent of prompts.
+        weights[0] = 0
+        weights[1] = 1
+        weights[2] = np.tile([1, -1], 288)
+        weights[3] = weights[2]
+        model = self.make_model(weights)
+        head = ch.prepare(model)
+        self.assertIsNotNone(head)
+        inputs = [rng.normal(size=576), np.zeros(576), np.ones(576),
+                  np.tile([1, -1], 288), np.full(576, 2.0**-64),
+                  np.full(576, 2.0**16)]
+        # Sum 1 + 1/256 is a BF16 midpoint; rows above include constant ones.
+        midpoint = np.zeros(576)
+        midpoint[:2] = [1, 1/256]
+        inputs.append(midpoint)
+        for x in inputs:
+            h = mx.array(x.astype(np.float32)).astype(mx.bfloat16).reshape(1, 1, -1)
+            h32 = h.astype(mx.float32).reshape(1, -1)
+            hn = mx.array(ch.float32_upper(norm_upper(np.asarray(h32))[0]))
+            reference = model.model.embed_tokens.as_linear(h).reshape(-1)
+            coarse = mx.quantized_matmul(h32, head.packed, head.scales,
+                                         head.biases, group_size=64, bits=4).reshape(-1)
+            refined = mx.sum(head.weight.astype(mx.float32) * h32, axis=-1)
+            for center, error, absolute in (
+                (coarse, head.coarse_error, ch.ABS_ERROR),
+                (refined, head.refined_error, 2 * ch.ABS_ERROR),
+            ):
+                lower, upper = ch.intervals(center, hn, error, absolute)
+                self.assertTrue((mx.all(lower <= reference)
+                                 & mx.all(reference <= upper)).item())
+
+    def test_certification_ties_negative_scores_and_range_fallback(self):
+        mx, ch = self.mx, self.ch
+        h = mx.ones((1, 1, 64), dtype=mx.bfloat16)
+        for negative in (False, True):
+            weights = np.full((512, 64), -1 if negative else 0, np.float32)
+            weights[0] = -0.5 if negative else 1
+            model = self.make_model(weights)
+            head = ch.prepare(model)
+            self.assertEqual(ch.screen(head, h).item(), 0)
+            # This also puts many equal upper bounds at the shortlist cutoff.
+            self.assertIsNone(ch.screen(head, mx.zeros_like(h)))
+            self.assertIsNone(ch.screen(head, (h * 2.0**17).astype(mx.bfloat16)))
+
+        for last_value in (1, 1.0078125):
+            weights = np.zeros((512, 64), np.float32)
+            weights[:2] = 1
+            weights[1, -1] = last_value
+            model = self.make_model(weights)
+            head = ch.prepare(model)
+            scores = model.model.embed_tokens.as_linear(h).reshape(-1)
+            # Distinct real dots can round to the same BF16 score.
+            self.assertEqual(scores[0].item(), scores[1].item())
+            self.assertIsNone(ch.screen(head, h))
+
+    def test_trajectories_pending_token_and_shared_model(self):
+        from . import inference
+        from reference.inference import generate as reference
+
+        mx, ch = self.mx, self.ch
+        weights = np.zeros((512, 64), np.float32)
+        weights[0] = 1
+        mx.random.seed(493)
+        model = self.make_model(weights)
+        original_weight = model.model.embed_tokens.weight
+        original_values = np.asarray(original_weight.astype(mx.float32)).copy()
+        for budget in (0, 1, 6):
+            expected = reference(model, [0, 0], budget)
+            first, state = inference.prefill(model, [0, 0])
+            calls = []
+            projections = []
+            def alternating(head, h):
+                calls.append(1)
+                return ch.screen(head, h) if len(calls) % 2 else None
+            embedding_type = type(model.model.embed_tokens)
+            original_projection = embedding_type.as_linear
+            def counted_projection(embedding, h):
+                projections.append(1)
+                return original_projection(embedding, h)
+            with (patch.object(inference, "screen", side_effect=alternating),
+                  patch.object(embedding_type, "as_linear", counted_projection)):
+                actual = inference.decode(model, first, state, budget)
+            self.assertEqual(actual, expected)
+            self.assertEqual(len(calls), max(0, budget-1))
+            self.assertEqual(len(projections), state.fallback)
+            self.assertTrue(all(c.offset == 2 + max(0, budget-1)
+                                for c in state.cache))
+            if budget == 6:
+                self.assertEqual((state.certified, state.fallback), (3, 2))
+            self.assertEqual(reference(model, [0, 0], budget), expected)
+        self.assertIs(model.model.embed_tokens.weight, original_weight)
+        np.testing.assert_array_equal(np.asarray(original_weight.astype(mx.float32)),
+                                      original_values)
+        # Auxiliary data must be rebuilt if a weight object is replaced.
+        before = ch.prepare(model)
+        model.model.embed_tokens.weight = original_weight + mx.zeros_like(original_weight)
+        self.assertIsNot(ch.prepare(model), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
