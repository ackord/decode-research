@@ -0,0 +1,174 @@
+"""Packed vocabulary scan with a certificate for the original BF16 head.
+
+Arithmetic contract (stock MLX 0.32.3 Metal, single vector):
+  mlx/backend/metal/matmul.cpp routes M=1 to gemv.h. DefaultAccT is float,
+  products and all partial sums are FP32, then a single BF16 conversion.
+  quantized.cpp routes affine M=1 to quantized.h's qmv (or qmv_quad).
+  Its U is float: sum(h*q)*s + sum(h)*b, with FP32 partial reductions.
+  Four-bit packed masks divide h by powers of two up to 4096. These are
+  exact outside underflow. No low-precision reconstructed weights occur.
+  Stock FP32 multiply/add (separate or fused, including reassociation) and
+  reductions are enclosed using unit roundoff 2^-24. BF16 casts are the
+  same monotone conversion in GEMV and our interval mapping.
+
+The reference and explicit refinement need at most 2d rounding factors
+per term. The affine scan needs fewer than 8d+32 even if all dot, input
+sum, group scale/bias, and final reduction operations are counted serially.
+Apply gamma_(8d+32) to sum |h|*(|s*q|+|b|), NOT to the reconstruction's
+norm: scale/bias cancellation cannot invalidate this bound. Cauchy-Schwarz
+gives H*A. The triangle inequality adds H*R and the reference's H*S error.
+
+FTZ/underflow: each operation can additionally lose at most 2^-126. With
+d<=576, input/parameter magnitudes <=2^16 and nonzero >=2^-64, rescaling
+loss is amplified by at most 4096, a scale by at most 2^16, and fewer than
+8d+32 operations contribute. Even including propagation (1+gamma), their
+total is <2^-80. Use 2^-80 per projection, twice for refinement versus
+reference. These guards also keep every intermediate far below overflow
+(even d*15*2^32 <2^46). Zeros and cancellation remain supported. Unknown
+versions/devices/dtypes and exceptional input ranges fall back. This is
+an arithmetic-adapter restriction, not a hardware-dependent mechanism.
+"""
+
+from dataclasses import dataclass
+from importlib.metadata import version
+import weakref
+
+import mlx.core as mx
+import mlx.nn as nn
+from mlx_lm.models.llama import Model
+import numpy as np
+
+from ._bounds import coefficients, float32_upper, norm_upper, supported_range
+
+
+GROUP_SIZE = 64
+BITS = 4
+REFINE_ROWS = 256
+ABS_ERROR = 2.0**-80
+_STOCK_VERSIONS = (version("mlx") == "0.32.3"
+                   and version("mlx-lm") == "0.32.0")
+
+
+@dataclass(frozen=True)
+class Head:
+    weight: object
+    packed: object
+    scales: object
+    biases: object
+    coarse_error: object
+    refined_error: object
+
+
+# Model is a dict subclass, so use identity plus a weak reference, not hashing.
+# Only immutable weight-derived state survives requests; keep at most one head.
+_prepared = None
+
+
+def arithmetic_supported():
+    return _STOCK_VERSIONS and mx.default_device().type == mx.gpu
+
+
+def prepare(model):
+    global _prepared
+    if (not arithmetic_supported() or type(model) is not Model
+            or not model.args.tie_word_embeddings
+            or type(model.model.embed_tokens) is not nn.Embedding):
+        return None
+    w = model.model.embed_tokens.weight
+    if w.dtype != mx.bfloat16 or w.ndim != 2:
+        return None
+    n, d = w.shape
+    if d > 576 or d % GROUP_SIZE or n <= REFINE_ROWS:
+        return None
+    if _prepared is not None:
+        owner, old_w, head = _prepared
+        if owner() is model and old_w is w:
+            return head
+
+    # Separate FP32 input ensures the saved affine parameters are FP32.
+    q, s, b = mx.quantize(w.astype(mx.float32), group_size=GROUP_SIZE,
+                          bits=BITS, mode="affine")
+    mx.eval(q, s, b)
+    if s.dtype != mx.float32 or b.dtype != mx.float32:
+        return None
+    coarse, refined = [], []
+    for start in range(0, n, 256):
+        stop = min(start + 256, n)
+        original = np.asarray(w[start:stop].astype(mx.float32))
+        scales, biases = np.asarray(s[start:stop]), np.asarray(b[start:stop])
+        if not all(supported_range(x) for x in (original, scales, biases)):
+            return None
+        packed = np.asarray(q[start:stop])
+        shifts = np.arange(8, dtype=np.uint32) * 4
+        codes = ((packed[..., None] >> shifts) & 15).reshape(stop-start, d)
+        c, r = coefficients(original, codes, scales, biases)
+        coarse.append(c)
+        refined.append(r)
+    head = Head(w, q, s, b, mx.array(np.concatenate(coarse)),
+                mx.array(np.concatenate(refined)))
+    mx.eval(head.coarse_error, head.refined_error)
+    _prepared = (weakref.ref(model), w, head)
+    return head
+
+
+def adjacent(x, upward):
+    """One FP32 successor/predecessor using stock integer operations.
+
+    Handles signed zero explicitly. Callers reject nonfinite endpoints.
+    """
+    bits = x.view(mx.uint32)
+    positive_step = mx.where(x >= 0, bits + 1, bits - 1)
+    negative_step = mx.where(x > 0, bits - 1, bits + 1)
+    stepped = positive_step if upward else negative_step
+    zero = 1 if upward else 0x80000001
+    return mx.where(x == 0, mx.array(zero, mx.uint32), stepped).view(mx.float32)
+
+
+def intervals(center, h_norm, coefficient, absolute):
+    # Positive multiplication/addition and signed endpoints each rounded out.
+    # If the positive product flushes, the lost amount is <2^-126; the final
+    # successor at radius >=2^-80 adds >=2^-104, also enclosing that loss.
+    # Nonzero endpoints near this radius cannot themselves be subnormal.
+    radius = adjacent(adjacent(h_norm * coefficient, True) + absolute, True)
+    low = adjacent(center - radius, False)
+    high = adjacent(center + radius, True)
+    return (low.astype(mx.bfloat16).astype(mx.float32),
+            high.astype(mx.bfloat16).astype(mx.float32))
+
+
+def screen(head, native_h):
+    """Return a certified token or None, without evaluating the full head."""
+    if (not arithmetic_supported() or native_h.dtype != mx.bfloat16
+            or native_h.shape != (1, 1, head.weight.shape[1])):
+        return None
+    h = native_h.astype(mx.float32).reshape(1, -1)
+    # Tiny host transfer is timed decode work. It also supplies range guards
+    # and an outward FP64 norm without relying on GPU sqrt accuracy.
+    host_h = np.asarray(h)
+    if not supported_range(host_h):
+        return None
+    h_norm = mx.array(float32_upper(norm_upper(host_h)[0]))
+    center = mx.quantized_matmul(h, head.packed, head.scales, head.biases,
+                                transpose=True, group_size=GROUP_SIZE,
+                                bits=BITS, mode="affine").reshape(-1)
+    low, high = intervals(center, h_norm, head.coarse_error, ABS_ERROR)
+    # kth is the largest excluded bound. Equality at the cutoff is covered,
+    # irrespective of which tied indices argpartition places in the shortlist.
+    cutoff = head.weight.shape[0] - REFINE_ROWS - 1
+    partition = mx.argpartition(high, cutoff)
+    selected = partition[-REFINE_ROWS:]
+    excluded = high[partition[cutoff]]
+    rows = head.weight[selected].astype(mx.float32)  # Gather BEFORE conversion.
+    exact_center = mx.sum(rows * h, axis=-1)
+    refined_low, refined_high = intervals(
+        exact_center, h_norm, head.refined_error[selected], 2 * ABS_ERROR)
+    winner = mx.argmax(refined_low)
+    other = mx.max(mx.where(mx.arange(REFINE_ROWS) == winner,
+                           -float("inf"), refined_high))
+    valid = (mx.all(mx.isfinite(center)) & mx.all(mx.isfinite(low))
+             & mx.all(mx.isfinite(high)) & mx.all(mx.isfinite(refined_low))
+             & mx.all(mx.isfinite(refined_high)))
+    certified = valid & (refined_low[winner] > mx.maximum(other, excluded))
+    token = selected[winner].reshape(1)
+    mx.eval(certified, token)
+    return token if certified.item() else None
