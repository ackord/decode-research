+def _preview(cache, remaining):
+    # Advisory only: no KV inspection or reads of pending token tensors.
+    if remaining < 2 or (cache.history[-1],) not in cache.index:
+        return False
+    cache.stats["previews"] += 1
+    context = cache.match()
+    limit = min(MAX_DRAFTS, len(context), remaining - 1)
+    _, score = _walk(cache, context, limit, preview=True)
+    return score >= MIN_DRAFT_SCORE
