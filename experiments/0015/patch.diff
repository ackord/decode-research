+def _walk(cache, context, limit, preview=False):
+    """Score full-context extensions using only committed successor counts."""
+    drafts = []
+    probability = 1.0
+    score = 0.0
+    for _ in range(max(0, limit)):
+        successors = cache.index.get(context)
+        if successors is None:
+            break
+        token = successors.preferred
+        probability *= successors.counts[token] / successors.total
+        score += probability
+        if preview:
+            if score >= MIN_DRAFT_SCORE:
+                break
+        else:
+            drafts.append(token)
+        context += (token,)
+    return drafts, score
+
