+"""Two independent residual horizons; the target and its vocabulary stay frozen.
+
+On a model-capable host, run `python -m candidate.residual_heads` once before
+validation. Training has no access to harness prompts, outputs or timings.
+Only the exported immutable BF16 parameters are used during requests.
+"""
+import hashlib
+import json
+from importlib.metadata import version
+from pathlib import Path
+
+import mlx.core as mx
+import mlx.nn as nn
+
+MODEL_ID = "mlx-community/SmolLM2-135M-Instruct"
+MODEL_REVISION = "422de227b90002f443a21a58b1087f6ee7632731"
+CORPUS = "Salesforce/wikitext"
+CORPUS_REVISION = "b08601e04326c79dfdd32d625aee71d232d685c3"
+ROOT = Path(__file__).resolve().parent
+ARTIFACT = ROOT / "residual_heads.safetensors"
+MANIFEST = ROOT / "residual_heads.manifest.json"
+RECIPE = {
+    "corpus": CORPUS, "corpus_revision": CORPUS_REVISION,
+    "configuration": "wikitext-2-raw-v1", "split": "train",
+    "model": MODEL_ID, "model_revision": MODEL_REVISION,
+    "tokenizer_revision": MODEL_REVISION,
+    "join": "newline", "add_special_tokens": False,
+    "block_length": 128, "blocks": 4096, "selection_seed": 0,
+    "continuation_length": 64, "continue_after_eos": True,
+    "examples_per_block": 62, "examples": 253952,
+    "alignment": "(f_i, embedding(y_i)) -> (y_(i+1), y_(i+2)); i=0..61",
+    "initialization": "zeros", "training_dtype": "float32",
+    "epochs": 3, "shuffle_seed": 0, "batch_size": 256,
+    "optimizer": "AdamW", "learning_rate": 0.001,
+    "betas": [0.9, 0.999], "epsilon": 1e-8, "weight_decay": 0.01,
+    "bias_correction": True, "loss": "mean of two cross entropies",
+    "export_dtype": "bfloat16",
+}
+_PARAMETERS = None
+
+
+def _sha(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def load_predictor(model):
+    global _PARAMETERS
+    if (not model.args.tie_word_embeddings
+            or model.model.embed_tokens.weight.shape != (49152, 576)
+            or model.model.embed_tokens.weight.dtype != mx.bfloat16):
+        return None
+    if _PARAMETERS is not None:
+        return _PARAMETERS
+    if not ARTIFACT.exists() and not MANIFEST.exists():
+        # Training unavailability must not silently install an untrained head.
+        return None
+    manifest = json.loads(MANIFEST.read_text())
+    if (manifest["recipe"] != RECIPE or manifest["training_steps"] != 2976
+            or manifest["artifact_sha256"] != _sha(ARTIFACT)):
+        raise ValueError("Residual-head artifact does not match the frozen recipe")
+    parameters = mx.load(str(ARTIFACT))
+    if (set(parameters) != {"A", "b"}
+            or parameters["A"].shape != (1152, 1152)
+            or parameters["b"].shape != (1152,)
+            or any(p.dtype != mx.bfloat16 for p in parameters.values())):
+        raise ValueError("Invalid residual-head parameters")
+    mx.eval(parameters)
+    _PARAMETERS = parameters
+    return parameters
+
+
+def _residual(parameters, z, embedding):
+    u = mx.concatenate([z, embedding], axis=-1) @ parameters["A"].T + parameters["b"]
+    u = u.reshape(-1, 2, 576)
+    return z[:, None, :] + nn.silu(u)
+
+
+def propose(model, parameters, feature, token):
+    z = feature.reshape(1, 576)
+    embedding = model.model.embed_tokens(token.reshape(1)).reshape(1, 576)
+    rows = _residual(parameters, z, embedding).reshape(2, 576)
+    # A single two-row projection; no target KV writes or token host reads.
+    logits = model.model.embed_tokens.as_linear(rows)
+    return mx.argmax(logits, axis=-1).astype(token.dtype)
+
+
+def train():
+    """Fixed corpus-only training and atomic, fingerprinted artifact export."""
+    import tempfile
+    import numpy as np
+    import mlx.optimizers as optim
+    from datasets import load_dataset
+    from huggingface_hub import snapshot_download
+    from mlx_lm import load
+    from mlx_lm.models.cache import make_prompt_cache
+    from mlx.utils import tree_flatten
+    from .inference import _native_forward, _grouped_supported
+
+    if ARTIFACT.exists() or MANIFEST.exists():
+        raise FileExistsError("Remove both existing artifacts explicitly before retraining")
+    # Every temporary training/cache file is inside candidate and is removed,
+    # including on failure. No training examples survive artifact handoff.
+    with tempfile.TemporaryDirectory(prefix=".residual-training-", dir=ROOT) as directory:
+        temporary = Path(directory)
+        snapshot = Path(snapshot_download(MODEL_ID, revision=MODEL_REVISION,
+                                         cache_dir=temporary / "hub"))
+        model, tokenizer = load(str(snapshot))
+        weights_before = {name: _sha(path) for name, path in
+                          ((str(p.relative_to(snapshot)), p)
+                           for p in sorted(snapshot.rglob("*")) if p.is_file())}
+        identities = [id(module) for _, module in model.named_modules()]
+
+        def target_hashes():
+            return {name: hashlib.sha256(np.asarray(value.view(mx.uint16)).tobytes()).hexdigest()
+                    for name, value in tree_flatten(model.parameters())}
+
+        arrays_before = target_hashes()
+        assert _grouped_supported(model, make_prompt_cache(model))
+        target_weight = model.model.embed_tokens.weight.astype(mx.float32)
+        dataset = load_dataset(CORPUS, "wikitext-2-raw-v1", split="train",
+                               revision=CORPUS_REVISION, cache_dir=str(temporary / "corpus"))
+        text = "\n".join(dataset["text"])
+        tokens = np.asarray(tokenizer.encode(text, add_special_tokens=False), dtype=np.int32)
+        selected = np.random.default_rng(0).choice(len(tokens) // 128, 4096, replace=False)
+        # Disk-backed feature storage bounds RAM during frozen-target generation.
+        features = np.memmap(temporary / "features.bin", mode="w+", dtype=np.float32,
+                             shape=(4096, 62, 576))
+        generated = np.memmap(temporary / "generated.bin", mode="w+", dtype=np.int32,
+                              shape=(4096, 64))
+        for block_index, span in enumerate(selected):
+            cache = make_prompt_cache(model)
+            prompt = mx.array(tokens[span * 128:(span + 1) * 128])[None]
+            logits, feature = _native_forward(model, prompt, cache, True)
+            token = mx.argmax(logits[:, -1, :], axis=-1)
+            for i in range(64):
+                mx.eval(token, feature)
+                generated[block_index, i] = token.item()
+                if i < 62:
+                    features[block_index, i] = np.asarray(feature.reshape(576).astype(mx.float32))
+                if i < 63:
+                    logits, feature = _native_forward(model, token.reshape(1, 1), cache, True)
+                    token = mx.argmax(logits[:, -1, :], axis=-1)
+            del logits, feature, token, cache, prompt
+            if (block_index + 1) % 128 == 0:
+                print(f"Frozen continuations: {block_index + 1}/4096", flush=True)
+        features.flush()
+        generated.flush()
+        feature_hash = _sha(temporary / "features.bin")
+        continuation_hash = _sha(temporary / "generated.bin")
+        parameters = {"A": mx.zeros((1152, 1152), dtype=mx.float32),
+                      "b": mx.zeros((1152,), dtype=mx.float32)}
+        optimizer = optim.AdamW(learning_rate=1e-3, betas=[0.9, 0.999], eps=1e-8,
+                               weight_decay=0.01, bias_correction=True)
+
+        def loss(params, z, pending, labels):
+            rows = _residual(params, z, target_weight[pending])
+            logits = rows @ target_weight.T
+            return nn.losses.cross_entropy(logits, labels, reduction="mean")
+
+        value_and_grad = mx.value_and_grad(loss)
+        shuffle = np.random.default_rng(0)
+        flat_features = features.reshape(253952, 576)
+        steps = 0
+        for epoch in range(3):
+            order = shuffle.permutation(253952)
+            for lo in range(0, len(order), 256):
+                indices = order[lo:lo + 256]
+                blocks, positions = indices // 62, indices % 62
+                z = mx.array(np.asarray(flat_features[indices]))
+                pending = mx.array(np.asarray(generated[blocks, positions]))
+                labels = mx.array(np.stack([generated[blocks, positions + 1],
+                                            generated[blocks, positions + 2]], axis=1))
+                value, gradients = value_and_grad(parameters, z, pending, labels)
+                parameters = optimizer.apply_gradients(gradients, parameters)
+                mx.eval(parameters, optimizer.state, value)
+                steps += 1
+            print(f"Epoch {epoch + 1}/3 complete", flush=True)
+        assert steps == 2976
+        assert all(p.dtype == mx.float32 for p in parameters.values())
+        assert identities == [id(module) for _, module in model.named_modules()]
+        assert weights_before == {name: _sha(snapshot / name) for name in weights_before}
+        assert arrays_before == target_hashes()
+        export = temporary / ARTIFACT.name
+        mx.save_safetensors(str(export), {k: v.astype(mx.bfloat16) for k, v in parameters.items()})
+        manifest = {
+            "recipe": RECIPE, "training_steps": steps,
+            "selected_spans": [[int(i) * 128, (int(i) + 1) * 128] for i in selected],
+            "dataset_fingerprint": dataset._fingerprint,
+            "corpus_text_sha256": hashlib.sha256(text.encode()).hexdigest(),
+            "token_ids_sha256": hashlib.sha256(tokens.tobytes()).hexdigest(),
+            "features_sha256": feature_hash, "continuations_sha256": continuation_hash,
+            "target_and_tokenizer_files": weights_before, "target_arrays_sha256": arrays_before,
+            "versions": {name: version(name) for name in
+                         ("mlx", "mlx-lm", "numpy", "datasets", "huggingface-hub", "transformers")},
+            "artifact_sha256": _sha(export), "artifact_bytes": export.stat().st_size,
+            "parameter_bytes": 2656512,
+        }
+        manifest_file = temporary / MANIFEST.name
+        manifest_file.write_text(json.dumps(manifest, indent=2) + "\n")
+        # Release mappings before TemporaryDirectory removes their backing data.
+        del flat_features, features, generated
+        export.replace(ARTIFACT)
+        manifest_file.replace(MANIFEST)
+
+
+if __name__ == "__main__":
+    train()
