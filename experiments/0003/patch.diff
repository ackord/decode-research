+"""Exact host interval arithmetic for a *proved* FP32/BF16 head contract.
+
+This does not infer an arithmetic contract from numerical agreement or dtype.
+The caller must establish operation depths, rounding, and conversion behavior.
+"""
+
+from dataclasses import dataclass
+from fractions import Fraction
+from math import isfinite, isqrt
+import struct
+
+
+F32_MIN_NORMAL = Fraction(1, 1 << 126)
+F32_MAX = Fraction((1 << 24) - 1) * (1 << 104)
+
+
+def _sqrt_up(x):
+    # Integer arithmetic gives a rational upper bound; no rounded reduction,
+    # square root, coefficient construction, or interval endpoint is used.
+    scale = 1 << 160
+    root = isqrt(x.numerator * scale * scale // x.denominator)
+    if Fraction(root * root, scale * scale) < x:
+        root += 1
+    return Fraction(root, scale)
+
+
+def _bf16_value(bits):
+    return Fraction(struct.unpack(">f", struct.pack(">I", bits << 16))[0])
+
+
+def _bf16_bits(value):
+    bits = struct.unpack(">I", struct.pack(">f", value))[0]
+    if bits & 0xffff:
+        raise ValueError("Value is not losslessly promoted BF16")
+    return bits >> 16
+
+
+def _cell(value):
+    """Closed superset of the RN-even BF16 conversion preimage."""
+    bits = _bf16_bits(value)
+    magnitude = bits & 0x7fff
+    if magnitude == 0:
+        half_step = Fraction(1, 1 << 134)
+        return -half_step, half_step
+    if magnitude >= 0x7f7f:
+        raise ValueError("Exceptional or overflow-adjacent output")
+    before, after = (bits - 1, bits + 1) if value > 0 else (bits + 1, bits - 1)
+    q = Fraction(value)
+    return (_bf16_value(before) + q) / 2, (q + _bf16_value(after)) / 2
+
+
+def _round_bf16(x):
+    """Exact RN-even conversion of a rational endpoint (finite range only)."""
+    negative = x < 0
+    x = abs(x)
+    lo, hi = 0, 0x7f7f
+    if x > _bf16_value(hi):
+        raise ValueError("Endpoint outside guarded range")
+    while lo < hi:
+        mid = (lo + hi + 1) // 2
+        if _bf16_value(mid) <= x:
+            lo = mid
+        else:
+            hi = mid - 1
+    if lo < 0x7f7f:
+        midpoint = (_bf16_value(lo) + _bf16_value(lo + 1)) / 2
+        if x > midpoint or (x == midpoint and lo & 1):
+            lo += 1
+    value = _bf16_value(lo)
+    return -value if negative else value
+
+
+@dataclass(frozen=True)
+class Arithmetic:
+    """Contract for ordinary RN FP32 dot arithmetic, including possible FTZ.
+
+    Depths must bound all scalar operations along each dependency path. Dot
+    or matrix instructions need their own proof before using this contract.
+    No intermediate narrowing; BF16 inputs are promoted exactly; the final
+    conversion is RN-even with gradual underflow. FTZ of FP32 arithmetic is
+    bounded by one minimum-normal absolute error per operation. Input DAZ is
+    excluded by the range guard. Both depths include multiplication/reduction.
+    """
+
+    scalar_depth: int
+    batch_depths: tuple  # depths for block sizes 2, 3, 4, 5
+
+
+@dataclass(frozen=True)
+class Certificate:
+    arithmetic: Arithmetic
+    dimension: int
+    weight_norm: Fraction
+    weight_inputs_valid: bool
+
+    def radius(self, hidden, rows):
+        if not self.weight_inputs_valid or len(hidden) != self.dimension:
+            return None
+        if not 2 <= rows <= 5:
+            return None
+        if any(not isfinite(x) or (x != 0 and abs(x) < F32_MIN_NORMAL)
+               for x in hidden):
+            return None
+        try:
+            for x in hidden:
+                _bf16_bits(x)
+        except (ValueError, OverflowError):
+            return None
+        h = _sqrt_up(sum((Fraction(x) ** 2 for x in hidden), Fraction()))
+        product = h * self.weight_norm
+        depths = (self.arithmetic.scalar_depth,
+                  self.arithmetic.batch_depths[rows - 2])
+        delta = Fraction()
+        for n in depths:
+            nu = Fraction(n, 1 << 24)
+            if n < 1 or nu >= 1:
+                return None
+            gamma = nu / (1 - nu)
+            absolute = n * F32_MIN_NORMAL / (1 - nu)
+            if (1 + gamma) * product + absolute >= F32_MAX:
+                return None
+            delta += gamma * product + absolute
+        return delta
+
+    def winner(self, hidden, rows, winner, runner_up, valid):
+        if not valid or not isfinite(winner) or not isfinite(runner_up):
+            return False
+        delta = self.radius(hidden, rows)
+        if delta is None:
+            return False
+        try:
+            lower = _round_bf16(_cell(winner)[0] - delta)
+            upper = _round_bf16(_cell(runner_up)[1] + delta)
+            return lower > upper
+        except (ValueError, OverflowError):
+            return False
+
+
+def weight_bound(max_abs, dimension, valid):
+    # ||w_i||_2 <= sqrt(d) max_ij |w_ij|, without an inexact norm reduction.
+    return _sqrt_up(Fraction(dimension)) * Fraction(max_abs) if valid else Fraction()
