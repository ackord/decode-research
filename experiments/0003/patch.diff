+
+def _arithmetic_contract():
+    # Fail closed. Audited MLX Metal dispatch distinguishes scalar GEMV from
+    # GEMM (and on some devices wide GEMV) for 2..5 rows. FP32 accumulator
+    # declarations do not prove dot/matrix instruction error or intermediate
+    # precision, nor do they identify the installed binary's arithmetic.
+    # https://github.com/ml-explore/mlx/blob/v0.32.3/mlx/backend/metal/matmul.cpp
+    # https://github.com/ml-explore/mlx/blob/v0.32.3/mlx/backend/metal/kernels/gemv.h
+    # No audited runtime contract is currently available. Do not substitute
+    # a version check, empirical probe, or user flag for such a contract.
+    return None
+
+
+class Request:
+    def __init__(self, cache, prompt, certificate):
+        self.cache = cache
+        self.history = []
+        self.index = {}
+        self.certificate = certificate
+        self.stats = {"accepted_lengths": [0] * 5, "rejected_positions": 0,
+                      "certified": 0, "fallbacks": 0, "scalar_steps": 0}
+        for token in prompt:
+            self.append(int(token))
+
+    def append(self, token):
+        j = len(self.history)
+        # Insert only suffixes whose continuation is observed at j. Inserting
+        # the terminal suffix itself would hide its productive earlier match.
+        for n in range(1, min(3, j) + 1):
+            self.index[tuple(self.history[j - n:j])] = j
+        self.history.append(token)
+
+    def continuation(self):
+        for n in range(min(3, len(self.history)), 0, -1):
+            j = self.index.get(tuple(self.history[-n:]))
+            if j is not None:
+                return j
+        return None
+
+
+def _certificate(model):
+    arithmetic = _arithmetic_contract()
+    if arithmetic is None or type(model) is not Model:
+        return None
+    if not model.args.tie_word_embeddings:
+        return None
+    weights = model.model.embed_tokens.weight
+    if weights.dtype != mx.bfloat16 or weights.ndim != 2:
+        return None
+    # Only immutable weight-derived metadata; kept within this fresh request.
+    promoted = weights.astype(mx.float32)
+    absolute = mx.abs(promoted)
+    maximum = mx.max(absolute)
+    valid = mx.all(mx.isfinite(promoted) &
+                   ((absolute == 0) | (absolute >= 2.0 ** -126)))
+    mx.eval(maximum, valid)
+    good = bool(valid.item())
+    bound = weight_bound(maximum.item(), weights.shape[1], good)
+    return Certificate(arithmetic, weights.shape[1], bound, good)
+
+
+def _room(cache):
+    if not cache or any(type(layer) is not KVCache for layer in cache):
+        return 0
+    offset = cache[0].offset
+    if any(layer.offset != offset or layer.keys is None or layer.values is None
+           or layer.keys.ndim != 4 or layer.values.ndim != 4
+           or layer.keys.shape[0] != 1 or layer.values.shape[0] != 1
+           for layer in cache):
+        return 0
+    capacity = min(min(layer.keys.shape[2], layer.values.shape[2])
+                   for layer in cache)
+    return capacity - offset - 1
+
+
+def _block(model, token, state, drafts):
+    hidden = []
+    for position in [token.item(), *drafts]:
+        inputs = mx.array([position], dtype=token.dtype).reshape(1, 1)
+        h = model.model(inputs, cache=state.cache)
+        # Materialize before advancing: retain native h, not old cache arrays.
+        mx.eval(h, *[array for layer in state.cache
+                     for array in (layer.keys, layer.values)])
+        hidden.append(h)
+
+    joined = mx.concatenate(hidden, axis=1)
+    logits = model.model.embed_tokens.as_linear(joined)[0]
+    ids = mx.argmax(logits, axis=-1)
+    scores = mx.take_along_axis(logits, ids[:, None], axis=-1)[:, 0]
+    competitors = mx.max(mx.where(mx.arange(logits.shape[-1])[None] == ids[:, None],
+                                  -float("inf"), logits), axis=-1)
+    valid = mx.all(mx.isfinite(logits), axis=-1)
+    # One small lossless FP32 transfer, with all summaries and native h values.
+    summaries = mx.concatenate((ids[:, None].astype(mx.float32),
+                                scores[:, None].astype(mx.float32),
+                                competitors[:, None].astype(mx.float32),
+                                valid[:, None].astype(mx.float32),
+                                joined[0].astype(mx.float32)), axis=1).tolist()
+    accepted = 0
+    for i, row in enumerate(summaries):
+        if (hidden[i].dtype == mx.bfloat16 and logits.dtype == mx.bfloat16
+                and logits.shape[-1] < (1 << 24)
+                and state.certificate.winner(row[4:], len(hidden), row[1], row[2], row[3])):
+            prediction = int(row[0])
+            state.stats["certified"] += 1
+        else:
+            # The saved original (1,1,d) hidden selects the scalar dispatch.
+            scalar = model.model.embed_tokens.as_linear(hidden[i])
+            result = mx.argmax(scalar[:, -1, :], axis=-1)
+            mx.eval(result)
+            prediction = result.item()
+            state.stats["fallbacks"] += 1
+        if i == len(drafts) or prediction != drafts[i]:
+            break
+        accepted += 1
+
+    rejected = len(drafts) - accepted
+    for layer in state.cache:
+        layer.trim(rejected)
+    state.stats["accepted_lengths"][accepted] += 1
+    state.stats["rejected_positions"] += rejected
+    return drafts[:accepted] + [prediction]
 
 
