+def _head_logits(model, cache, norm):
+    """Reuse each vocabulary panel across singleton positions before advancing.
+
+    Layout contract: the fixed model's unchanged safetensors embedding is row
+    contiguous; native final RMSNorm outputs are contiguous singleton vectors.
+    MLX has no public stride metadata. Do not substitute a strided embedding.
+    On 0.32.3 Metal, both widths dispatch GEMV with BM=8, BN=1, SM=1,
+    SN=32, TM=4, TN=4, matrix_ld=576 and one singleton batch. Panel offsets
+    align with 32-row groups, with no output tail. Each row retains its full
+    contraction, float accumulation/reduction and native BF16 conversion.
+    """
+    embedding = model.model.embed_tokens
+    head = embedding.as_linear if model.args.tie_word_embeddings else model.lm_head
+    eligible = (
+        _AUDITED_HEAD_RUNTIME
+        and mx.metal.is_available()
+        and mx.default_device().type == mx.gpu
+        and isinstance(cache, RequestCache)
+        and model.args.tie_word_embeddings
+        and type(embedding) is nn.Embedding
+        and embedding.weight.shape == (49152, 576)
+        and embedding.weight.dtype == mx.bfloat16
+        and 2 <= len(norm) <= 5
+        and all(x.shape == (1, 1, 576) and x.dtype == mx.bfloat16 for x in norm)
+    )
+    if not eligible:
+        return _project(head, norm, norm)
+
+    if cache.head_panels is None:
+        cache.head_panels = tuple(
+            embedding.weight[start : start + _PANEL_ROWS]
+            for start in range(0, 49152, _PANEL_ROWS)
+        )
+    parts = [[] for _ in norm]
+    dependencies = norm
+    for panel in cache.head_panels:
+        outputs = _project(lambda h: h @ panel.T, norm, dependencies)
+        for position, logits in zip(parts, outputs):
+            position.append(logits)
+        dependencies = outputs
+    # Gate every assembly on the entire final panel, so earlier concatenations
+    # cannot interrupt panel reuse. No host reads or synchronization per panel.
+    logits = [
+        mx.concatenate(mx.depends(position, dependencies), axis=-1)
+        for position in parts
+    ]
+    cache.stats["blocked_head_verifications"] += 1
+    return logits
+
