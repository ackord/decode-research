--- /dev/null
+++ b/candidate/test_inference.py
@@ -0,0 +1,161 @@
+"""Synthetic bookkeeping tests; these do not establish target-model parity."""
+
+import importlib.util
+from pathlib import Path
+import sys
+from types import ModuleType
+import unittest
+from unittest.mock import patch
+
+import numpy as np
+
+
+class SyntheticCache:
+    """Offset-only trim with retained, chunked allocation, like ordinary KVCache."""
+
+    def __init__(self):
+        self.offset = 0
+        self.storage = []
+
+    def write(self, tokens):
+        end = self.offset + len(tokens)
+        if end > len(self.storage):
+            self.storage.extend([None] * (((end + 255) // 256) * 256 - len(self.storage)))
+        self.storage[self.offset:end] = tokens
+        self.offset = end
+
+
+def load_candidate():
+    mx = ModuleType("mlx.core")
+    mx.array = np.array
+    mx.argmax = np.argmax
+    mx.eval = lambda *args: None
+    mlx = ModuleType("mlx")
+    mlx.core = mx
+    cache = ModuleType("mlx_lm.models.cache")
+    cache.make_prompt_cache = lambda model: [SyntheticCache() for _ in range(3)]
+
+    def trim(layers, count):
+        for layer in layers:
+            layer.offset -= count
+        return count  # Deliberately not the cache itself.
+
+    cache.trim_prompt_cache = trim
+    modules = {
+        "mlx": mlx,
+        "mlx.core": mx,
+        "mlx_lm": ModuleType("mlx_lm"),
+        "mlx_lm.models": ModuleType("mlx_lm.models"),
+        "mlx_lm.models.cache": cache,
+    }
+    spec = importlib.util.spec_from_file_location(
+        "synthetic_candidate", Path(__file__).with_name("inference.py")
+    )
+    module = importlib.util.module_from_spec(spec)
+    with patch.dict(sys.modules, modules):
+        spec.loader.exec_module(module)
+    return module
+
+
+class SyntheticModel:
+    def __init__(self, prompt, outputs):
+        self.prompt = list(prompt)
+        self.outputs = outputs
+        self.calls = []
+
+    def __call__(self, tokens, cache):
+        start = cache[0].offset
+        committed = self.prompt + self.outputs
+        for layer in cache:
+            assert layer.offset == start
+            assert layer.storage[:start] == committed[:start]
+        inputs = tokens[0].tolist()
+        self.calls.append((start, inputs))
+        logits = np.zeros((1, len(inputs), 64), dtype=np.float32)
+        for position in range(len(inputs)):
+            output_index = start + position - len(self.prompt) + 1
+            prediction = self.outputs[output_index] if output_index >= 0 else 0
+            # A tie also checks that full-vocabulary argmax keeps the first index.
+            logits[0, position, prediction:prediction + 2] = 1
+        for layer in cache:
+            layer.write(inputs)
+        return logits
+
+
+class InferenceTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.candidate = load_candidate()
+
+    def test_index_matches_independent_scan(self):
+        history = [1, 2, 1, 2, 1, 3, 1, 2]
+        state = self.candidate._RequestState([], [])
+        for token in history:
+            state.append(token)
+            observed = state.history
+            expected = {}
+            for j in range(1, len(observed)):
+                for n in range(1, min(3, j) + 1):
+                    expected[tuple(observed[j - n:j])] = j
+            self.assertEqual(state.index, expected)
+
+    def test_lookup_eligibility_overlap_and_budget(self):
+        state = self.candidate._RequestState([], [1, 2])
+        self.assertEqual(state.draft(8), [])  # Terminal suffix has no continuation.
+        state.append(1)
+        self.assertEqual(state.draft(8), [2, 1])  # Observed overlapping span.
+        self.assertEqual(state.draft(2), [2])
+        self.assertEqual(state.draft(1), [])
+        state = self.candidate._RequestState([], [1, 2, 3, 1, 2, 4, 1, 2])
+        self.assertEqual(state.draft(9), [4, 1, 2])  # Most recent longest match.
+
+    def test_acceptance_and_overwrite_across_capacity_boundary(self):
+        draft = [3, 4, 5, 6]
+        for accepted in range(5):
+            with self.subTest(accepted=accepted):
+                prompt = [40] * 244 + [1, 2, 3, 4, 5, 6, 7, 8, 9, 1]
+                expected = [2] + draft[:accepted] + [15, 16, 17, 18, 19, 20, 21]
+                model = SyntheticModel(prompt, expected + [22] * 8)
+                first, state = self.candidate.prefill(model, prompt)
+                self.assertEqual(len(model.calls), 1)
+                self.assertEqual(state.history, prompt)
+                result = self.candidate.decode(model, first, state, len(expected))
+                self.assertEqual(result, expected)
+                self.assertEqual(model.calls[1], (254, [2, *draft]))
+                if accepted < 4:
+                    self.assertEqual(model.calls[2][0], 255 + accepted)
+                for layer in state.raw_cache:
+                    self.assertEqual(layer.offset, len(prompt) + len(expected) - 1)
+                    self.assertEqual(layer.storage[:layer.offset], (prompt + expected)[:-1])
+                    self.assertGreaterEqual(len(layer.storage), 512)
+                self.assertEqual(state.history, prompt + expected)
+
+    def test_small_budgets_no_match_and_fixed_length(self):
+        for budget in [-1, 0, 1, 2, 7]:
+            with self.subTest(budget=budget):
+                prompt = [40, 41]
+                expected = [0, 10, 11, 12, 13, 14, 15, 16]
+                model = SyntheticModel(prompt, expected)
+                first, state = self.candidate.prefill(model, prompt)
+                result = self.candidate.decode(model, first, state, budget)
+                self.assertEqual(result, expected[:max(0, budget)])
+                self.assertEqual(len(model.calls), max(1, budget))
+                self.assertTrue(all(len(inputs) == 1 for _, inputs in model.calls[1:]))
+
+    def test_request_isolation_and_prompt_copy(self):
+        prompt = [1, 2, 1]
+        model = SyntheticModel(prompt, [2, 3, 4, 5, 6, 7])
+        first, state = self.candidate.prefill(model, prompt)
+        other_first, other = self.candidate.prefill(model, prompt)
+        prompt.append(9)
+        self.candidate.decode(model, first, state, 2)
+        self.assertEqual(other.history, [1, 2, 1])
+        self.assertEqual(other_first.item(), 2)
+        self.assertIsNot(state.index, other.index)
+        for left, right in zip(state.raw_cache, other.raw_cache):
+            self.assertIsNot(left, right)
+            self.assertEqual(right.offset, 3)
+
+
+if __name__ == "__main__":
+    unittest.main()
