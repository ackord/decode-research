+
+    def append(self, token):
+        # Only index occurrences with an observed following token.
+        j = len(self.history)
+        self.history.append(token)
+        for n in range(1, min(3, j) + 1):
+            self.index[tuple(self.history[j - n : j])] = j
+
+    def draft(self, remaining):
+        history = self.history
+        for n in range(min(3, len(history)), 0, -1):
+            j = self.index.get(tuple(history[-n:]))
