+    assert cache.stats["auxiliary_blocks"] > 0
+    for limit in (0, 1, 2):
+        cache = _clone(model, base)
+        cache.auxiliary = sidecar
+        assert ci.decode(model, pending, cache, limit) == oracle[:limit]
+        assert cache.stats["auxiliary_forwards"] == 0
+    fresh_pending, fresh = ci.prefill(model, prompt)
+    _equal(fresh_pending, pending, "fresh request first token")
+    assert fresh.auxiliary is not sidecar and fresh.history is not base.history
+    assert fresh.stats["auxiliary_forwards"] == fresh.stats["auxiliary_blocks"] == 0
+    assert modules == [(name, id(module)) for name, module in model.named_modules()]
+    current = dict(tree_flatten(model.parameters()))
