+class _Auxiliary:
+    """Request-owned packed weights; never replace or mutate target modules."""
+
+    def __init__(self, model):
+        def pack(weight):
+            packed, scales, biases = mx.quantize(
+                weight, group_size=64, bits=4, mode="affine")
+            return packed, scales.astype(mx.bfloat16), biases.astype(mx.bfloat16)
+
+        self.layers = []
+        for layer in model.layers:
+            a, f = layer.self_attn, layer.mlp
+            self.layers.append(tuple(pack(p.weight) for p in (
+                a.q_proj, a.k_proj, a.v_proj, a.o_proj,
+                f.gate_proj, f.up_proj, f.down_proj)))
+        self.head = pack(model.model.embed_tokens.weight)
+        mx.eval(*[array for weights in [*self.layers, (self.head,)]
+                  for projection in weights for array in projection])
+
+    @staticmethod
+    def project(weights, x):
+        w, scales, biases = weights
+        return mx.quantized_matmul(x, w, scales=scales, biases=biases,
+                                   transpose=True, group_size=64, bits=4,
+                                   mode="affine").astype(mx.bfloat16)
+
+    def forward(self, model, cache, token):
+        x = model.model.embed_tokens(token.reshape(1, 1))
+        for layer, kv, weights in zip(model.layers, cache, self.layers):
+            a = layer.self_attn
+            # Capture Python offsets/endpoints while constructing this pass.
+            start, end = kv.offset, kv.offset + 1
+            norm = layer.input_layernorm(x)
+            q, k, v = [self.project(w, norm) for w in weights[:3]]
+            q = q.reshape(1, 1, a.n_heads, -1).transpose(0, 2, 1, 3)
+            k = k.reshape(1, 1, a.n_kv_heads, -1).transpose(0, 2, 1, 3)
+            v = v.reshape(1, 1, a.n_kv_heads, -1).transpose(0, 2, 1, 3)
+            q, k = a.rope(q, offset=start), a.rope(k, offset=start)
+            kv.update_and_fetch(k, v)
+            attention = llama.scaled_dot_product_attention(
+                mx.depends(q, [kv.keys, kv.values]),
+                kv.keys[..., :end, :], kv.values[..., :end, :],
+                cache=kv, scale=a.scale, mask=None)
+            attention = attention.transpose(0, 2, 1, 3).reshape(1, 1, -1)
+            h = x + self.project(weights[3], attention)
+            norm = layer.post_attention_layernorm(h)
+            gate, up = [self.project(w, norm) for w in weights[4:6]]
+            x = h + self.project(weights[6], llama.swiglu(gate, up))
+        logits = self.project(self.head, model.model.norm(x))
+        cache.stats["auxiliary_forwards"] += 1
+        return mx.argmax(logits[:, -1, :], axis=-1)
+
+
+def _auxiliary_count(model, cache, remaining):
+    """Decide every fallback before touching shared exact KV storage."""
+    if cache.auxiliary is None or remaining < 3:
+        return 0
+    if cache.batch_rows_eligible is None:
+        cache.batch_rows_eligible = _batch_supported(model, cache)
+    if cache.grouped_eligible is None:
+        cache.grouped_eligible = _grouped_supported(model, cache)
+    if not cache.batch_rows_eligible or not cache.grouped_eligible:
+        return 0
+    if any(kv.keys is None or kv.values is None for kv in cache):
+        return 0
+    # Mirror the actual verifier's dtype and grouped layout gates, including
+    # cached False flags. Rotary, attention and head keep independent fallbacks.
+    for kv in cache:
+        if any(a.dtype != mx.bfloat16 or a.ndim != 4
+               or a.shape[:2] != (1, 3) or a.shape[3] != 64
+               for a in (kv.keys, kv.values)):
+            return 0
+    start = cache[0].offset
+    capacity = min(min(kv.keys.shape[2], kv.values.shape[2]) for kv in cache)
+    count = min(AUX_MAX_DRAFTS, remaining - 1, capacity - start - 1)
+    return count if count >= 2 and _bulk_start(cache, count + 1) == start else 0
+
+
+def _auxiliary_draft(model, cache, token, count):
+    start = cache[0].offset
+    proposals = []
+    for _ in range(count):
+        token = cache.auxiliary.forward(model, cache, token)
+        mx.async_eval(token)
+        proposals.append(token)
+    if any(kv.offset != start + count for kv in cache):
+        raise RuntimeError("Auxiliary draft did not append exactly its proposed tail")
+    for kv in cache:
+        kv.offset = start
+    cache.stats["auxiliary_blocks"] += 1
+    cache.stats["auxiliary_proposed_tokens"] += count
+    return proposals
 
 
