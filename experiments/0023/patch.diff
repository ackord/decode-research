+def _probe_banks(weight):
+    # A storage-sharing view, with element strides (18432, 1, 576).
+    return weight.reshape(1536, HEAD_PROBE_ROWS, 576).transpose(0, 2, 1)
+
+
+def _draft_probes(banks, norm_block, draft_ids):
+    k, m = len(draft_ids), norm_block.shape[1]
+    ids = mx.array(draft_ids, dtype=mx.uint32)
+    # Consume the complete block, not a prefix: all transformer/KV work must
+    # finish even if only the first head is retained. Explicit-index singleton
+    # gathers preserve the audited full-head contraction and BF16 conversion.
+    x = mx.depends(mx.contiguous(norm_block), [norm_block]).reshape(m, 1, 576)
+    products = mx.gather_mm(x, banks,
+        lhs_indices=mx.arange(k, dtype=mx.uint32),
+        rhs_indices=ids // HEAD_PROBE_ROWS, sorted_indices=False)
+    return mx.take_along_axis(products.reshape(k, HEAD_PROBE_ROWS),
+                              (ids % HEAD_PROBE_ROWS)[:, None], axis=1)[:, 0]
+
+
+def _screen_cutoff(norm_block, probes, first):
+    k, m = probes.shape[0], norm_block.shape[1]
+    witnesses = mx.max(first[0, :k, :], axis=-1) > probes
+    earliest = mx.min(mx.where(witnesses, mx.arange(k, dtype=mx.int32) + 1, m))
+    safe = mx.all(mx.abs(norm_block) <= 65536)
+    # This is the only screening read. Both probe scores and the entire first
+    # panel precede it; no later panel is constructed until it returns.
+    return int(mx.where(safe, earliest, m).item())
+
+
+def _screened_head(panels, banks, norm_block, draft_ids, group, stats):
+    m = norm_block.shape[1]
+    probes = _draft_probes(banks, norm_block, draft_ids)
+    first = group(panels[0], norm_block, [probes])
+    r = _screen_cutoff(norm_block, probes, first)
+    stats["screen_attempts"] += 1
+    stats["probe_calls"] += 1
+    stats["screen_cutoffs"][r] += 1
+    stats["omitted_projection_rows"] += 11 * HEAD_PANEL_ROWS * (m - r)
+    block = norm_block[:, :r, :]
+    outputs = [first[:, :r, :]]
+    previous = first
+    for panel in panels[1:]:
+        previous = group(panel, block, [previous])
+        outputs.append(previous)
+    return mx.concatenate(mx.depends(outputs, [outputs[-1]]), axis=-1)
+
