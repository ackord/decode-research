+def _screen_supported(model):
+    """Independent, request-local gate; elementwise bounds also reject NaNs."""
+    return (type(model) is llama.Model and _head_supported(model)
+            and bool(mx.all(mx.abs(model.model.embed_tokens.weight) <= 65536).item()))
+
