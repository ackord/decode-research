+def check_auxiliary(model):
+    """Active learned proposals and controlled rejection; no benchmark data."""
+    from mlx.utils import tree_flatten
+    # Artifact failures precede all request eligibility checks, even tiny budgets.
+    import json
+    import tempfile
+    from pathlib import Path
+    from . import residual_heads as rh
