+"""Frozen CPU teacher, corpus-only continuations, and fixed residual training.
+
+Run with candidate/.training-env/bin/python -m candidate.train_residual.
+No runtime inference or accelerator modules are imported on this path.
+"""
+import hashlib
+import json
+import os
+import platform
+from importlib.metadata import version
+from pathlib import Path
+
+from .residual_heads import (ROOT, ARTIFACT, MANIFEST, RECIPE, MODEL_ID,
+                             MODEL_REVISION, CORPUS, CORPUS_REVISION, _sha)
+
+
+def train():
+    # Redirect every download/cache before importing training dependencies.
+    work = ROOT / '.training'
+    work.mkdir(exist_ok=True)
+    os.environ['HF_HOME'] = str(work / 'hub')
+    os.environ['HF_HUB_DISABLE_XET'] = '1'
+    os.environ['TOKENIZERS_PARALLELISM'] = 'false'
+    import numpy as np
+    import torch
+    import torch.nn.functional as F
+    from datasets import load_dataset
+    from huggingface_hub import snapshot_download
+    from safetensors.torch import load_file, save_file
+    from transformers import AutoTokenizer, LlamaConfig, LlamaForCausalLM
+
+    if ARTIFACT.exists() or MANIFEST.exists():
+        raise FileExistsError('Artifacts already exist; no automatic retraining')
+    torch.set_num_threads(int(os.environ.get('RESIDUAL_CPU_THREADS', '4')))
+    torch.set_num_interop_threads(1)
+    torch.manual_seed(0)
+    settings = dict(device='cpu', dtype='float32', teacher_batch_size=16,
+                    threads=torch.get_num_threads(), interop_threads=1,
+                    attention='sdpa', deterministic_seed=0)
+    (work / 'execution_settings.json').write_text(json.dumps(settings, indent=2))
+    snapshot = Path(snapshot_download(MODEL_ID, revision=MODEL_REVISION,
+                                     cache_dir=str(work / 'hub'),
+                                     allow_patterns=['*.json', '*.safetensors', '*.model', '*.txt']))
+    file_hashes = {str(p.relative_to(snapshot)): _sha(p)
+                   for p in sorted(snapshot.rglob('*')) if p.is_file()}
+    config = LlamaConfig.from_pretrained(str(snapshot))
+    config._attn_implementation = 'sdpa'
+    # An independent target, initialized and loaded entirely on CPU in FP32.
+    teacher = LlamaForCausalLM(config).float().cpu().eval()
+    weights = {}
+    array_hashes = {}
+    for path in sorted(snapshot.glob('*.safetensors')):
+        shard = load_file(str(path), device='cpu')
+        if weights.keys() & shard.keys():
+            raise ValueError('Duplicate checkpoint tensors')
+        for name, value in shard.items():
+            if value.dtype != torch.bfloat16:
+                raise ValueError('Expected exact BF16 checkpoint values: ' + name)
+            array_hashes[name] = hashlib.sha256(value.view(torch.uint16).numpy().tobytes()).hexdigest()
+            weights[name] = value.float()
+    expected = teacher.state_dict()
+    if 'lm_head.weight' in weights:
+        if not torch.equal(weights['lm_head.weight'], weights['model.embed_tokens.weight']):
+            raise ValueError('Checkpoint head is not tied')
+    else:
+        weights['lm_head.weight'] = weights['model.embed_tokens.weight']
+    if weights.keys() != expected.keys():
+        raise ValueError(f'Incomplete tensor mapping: missing={expected.keys()-weights.keys()}, extra={weights.keys()-expected.keys()}')
+    teacher.load_state_dict(weights, strict=True)
+    teacher.tie_weights()
+    if teacher.lm_head.weight is not teacher.model.embed_tokens.weight:
+        raise ValueError('Tied head mapping failed')
+    for name, value in teacher.state_dict().items():
+        if value.dtype != torch.float32 or not torch.equal(value, weights[name]):
+            raise ValueError('Target loading changed checkpoint values: ' + name)
+    teacher.requires_grad_(False)
+    vocabulary = teacher.model.embed_tokens.weight
+    del weights, expected
+    tokenizer = AutoTokenizer.from_pretrained(str(snapshot))
+    dataset = load_dataset(CORPUS, 'wikitext-2-raw-v1', split='train',
+                           revision=CORPUS_REVISION, cache_dir=str(work / 'corpus'))
+    text = '\n'.join(dataset['text'])
+    tokens = np.asarray(tokenizer.encode(text, add_special_tokens=False), dtype=np.int32)
+    selected = np.random.default_rng(0).choice(len(tokens)//128, 4096, replace=False)
+    features = np.memmap(work / 'features.bin', mode='w+', dtype=np.float32,
+                         shape=(4096, 62, 576))
+    generated = np.memmap(work / 'generated.bin', mode='w+', dtype=np.int32,
+                          shape=(4096, 64))
+    with torch.inference_mode():
+        for lo in range(0, 4096, settings['teacher_batch_size']):
+            spans = selected[lo:lo+settings['teacher_batch_size']]
+            inputs = torch.from_numpy(np.stack([tokens[s*128:(s+1)*128] for s in spans])).long()
+            past = None
+            for i in range(64):
+                result = teacher.model(input_ids=inputs, past_key_values=past, use_cache=True)
+                past = result.past_key_values
+                f = result.last_hidden_state[:, -1, :]
+                y = F.linear(f, vocabulary).argmax(-1)
+                generated[lo:lo+len(spans), i] = y.numpy()
+                if i < 62:
+                    features[lo:lo+len(spans), i] = f.numpy()
+                inputs = y[:, None]  # Continue after EOS; fresh batch state per block.
+            del result, past, f, y, inputs
+            if (lo + len(spans)) % 128 == 0:
+                print(f'Frozen continuations: {lo+len(spans)}/4096', flush=True)
+    features.flush()
+    generated.flush()
+    A = torch.nn.Parameter(torch.zeros(1152, 1152))
+    b = torch.nn.Parameter(torch.zeros(1152))
+    optimizer = torch.optim.AdamW([A, b], lr=1e-3, betas=(.9, .999), eps=1e-8,
+                                  weight_decay=.01, foreach=False)
+    shuffle = np.random.default_rng(0)
+    flat = features.reshape(253952, 576)
+    steps = 0
+    for epoch in range(3):
+        order = shuffle.permutation(253952)
+        for lo in range(0, len(order), 256):
+            idx = order[lo:lo+256]
+            blocks, pos = idx//62, idx%62
+            f = torch.from_numpy(np.asarray(flat[idx]))
+            pending = torch.from_numpy(np.asarray(generated[blocks, pos])).long()
+            labels = torch.from_numpy(np.stack([generated[blocks, pos+1],
+                                               generated[blocks, pos+2]], axis=1)).long()
+            optimizer.zero_grad(set_to_none=True)
+            u = F.linear(torch.cat([f, F.embedding(pending, vocabulary)], dim=-1), A, b)
+            rows = f[:, None, :] + F.silu(u.reshape(256, 2, 576))
+            logits = F.linear(rows, vocabulary)
+            loss = F.cross_entropy(logits.reshape(-1, 49152), labels.reshape(-1))
+            loss.backward()
+            optimizer.step()
+            steps += 1
+            if steps % 128 == 0:
+                print(f'Updates: {steps}/2976 loss={loss.item():.5f}', flush=True)
+        print(f'Epoch {epoch+1}/3 complete', flush=True)
+    assert steps == 2976
+    export = {name: p.detach().to(torch.bfloat16).contiguous() for name, p in [('A', A), ('b', b)]}
+    for p in export.values():
+        if not torch.isfinite(p).all() or not torch.any(p != 0):
+            raise ValueError('Nonfinite or untrained artifact')
+    path = work / ARTIFACT.name
+    save_file(export, str(path))
+    loaded = load_file(str(path))
+    assert loaded.keys() == export.keys()
+    assert all(torch.equal(loaded[k], v) and loaded[k].dtype == torch.bfloat16
+               for k, v in export.items())
+    # Verify all target tensors still hold the exact frozen checkpoint values.
+    for shard in sorted(snapshot.glob('*.safetensors')):
+        for name, original in load_file(str(shard)).items():
+            assert torch.equal(teacher.state_dict()[name], original.float()), name
+    manifest = dict(recipe=RECIPE, training_steps=steps,
+                    selected_spans=[[int(s)*128, (int(s)+1)*128] for s in selected],
+                    corpus_text_sha256=hashlib.sha256(text.encode()).hexdigest(),
+                    token_ids_sha256=hashlib.sha256(tokens.tobytes()).hexdigest(),
+                    features_sha256=_sha(work / 'features.bin'),
+                    continuations_sha256=_sha(work / 'generated.bin'),
+                    dataset_fingerprint=dataset._fingerprint,
+                    target_and_tokenizer_files=file_hashes, target_arrays_sha256=array_hashes,
+                    trainer_sha256=_sha(Path(__file__)), backend='torch-cpu',
+                    execution_settings=settings, python=platform.python_version(),
+                    versions={n: version(n) for n in ('torch', 'numpy', 'transformers',
+                              'datasets', 'huggingface-hub', 'safetensors')},
+                    artifact_sha256=_sha(path), artifact_bytes=path.stat().st_size,
+                    parameter_bytes=2656512)
+    manifest_path = work / MANIFEST.name
+    manifest_path.write_text(json.dumps(manifest, indent=2)+'\n')
+    path.replace(ARTIFACT)
+    manifest_path.replace(MANIFEST)
+    print('Final trained BF16 artifact exported', flush=True)
+
+
+if __name__ == '__main__':
+    train()
