+"""Two independent residual horizons; the target and its vocabulary stay frozen.
+
+On a model-capable host, run `python -m candidate.residual_heads` once before
+validation. Training has no access to harness prompts, outputs or timings.
+Only the exported immutable BF16 parameters are used during requests.
+"""
+import hashlib
+import json
+from pathlib import Path
+
+
+MODEL_ID = "mlx-community/SmolLM2-135M-Instruct"
+MODEL_REVISION = "422de227b90002f443a21a58b1087f6ee7632731"
+CORPUS = "Salesforce/wikitext"
+CORPUS_REVISION = "b08601e04326c79dfdd32d625aee71d232d685c3"
+ROOT = Path(__file__).resolve().parent
+ARTIFACT = ROOT / "residual_heads.safetensors"
+MANIFEST = ROOT / "residual_heads.manifest.json"
+RECIPE = {
+    "corpus": CORPUS, "corpus_revision": CORPUS_REVISION,
+    "configuration": "wikitext-2-raw-v1", "split": "train",
+    "model": MODEL_ID, "model_revision": MODEL_REVISION,
+    "tokenizer_revision": MODEL_REVISION,
+    "join": "newline", "add_special_tokens": False,
+    "block_length": 128, "blocks": 4096, "selection_seed": 0,
+    "continuation_length": 64, "continue_after_eos": True,
+    "examples_per_block": 62, "examples": 253952,
+    "alignment": "(f_i, embedding(y_i)) -> (y_(i+1), y_(i+2)); i=0..61",
+    "initialization": "zeros", "training_dtype": "float32",
+    "epochs": 3, "shuffle_seed": 0, "batch_size": 256,
+    "optimizer": "AdamW", "learning_rate": 0.001,
+    "betas": [0.9, 0.999], "epsilon": 1e-8, "weight_decay": 0.01,
+    "bias_correction": True, "loss": "mean of two cross entropies",
+    "export_dtype": "bfloat16",
+}
+_PARAMETERS = None
+
+
+def _sha(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def validate_manifest():
+    """CPU-only provenance validation, also used before runtime activation."""
+    manifest = json.loads(MANIFEST.read_text())
+    required = {"selected_spans", "corpus_text_sha256", "token_ids_sha256",
+                "features_sha256", "continuations_sha256", "target_and_tokenizer_files",
+                "target_arrays_sha256", "trainer_sha256", "backend", "versions",
+                "execution_settings"}
+    if (not required <= manifest.keys() or manifest.get("recipe") != RECIPE
+            or manifest.get("training_steps") != 2976
+            or manifest.get("trainer_sha256") != _sha(ROOT / "train_residual.py")
+            or manifest.get("artifact_sha256") != _sha(ARTIFACT)
+            or len(manifest["selected_spans"]) != 4096):
+        raise ValueError("Incomplete or mismatched trained residual-head manifest")
+    spans = manifest["selected_spans"]
+    if (len({tuple(s) for s in spans}) != 4096
+            or any(len(s) != 2 or s[0] % 128 or s[1] != s[0] + 128 for s in spans)):
+        raise ValueError("Invalid training spans")
+    return manifest
+
+
+def load_predictor(model):
+    import mlx.core as mx
+    global _PARAMETERS
+    if (not model.args.tie_word_embeddings
+            or model.model.embed_tokens.weight.shape != (49152, 576)
+            or model.model.embed_tokens.weight.dtype != mx.bfloat16):
+        return None
+    if _PARAMETERS is not None:
+        return _PARAMETERS
+    if not ARTIFACT.is_file() or not MANIFEST.is_file():
+        raise FileNotFoundError("Trained residual heads and manifest are required; run candidate.train_residual")
+    validate_manifest()
+    parameters = mx.load(str(ARTIFACT))
+    if (set(parameters) != {"A", "b"}
+            or parameters["A"].shape != (1152, 1152)
+            or parameters["b"].shape != (1152,)
+            or any(p.dtype != mx.bfloat16 for p in parameters.values())):
+        raise ValueError("Invalid residual-head parameters")
+    mx.eval(parameters)
+    if any(not mx.all(mx.isfinite(p)).item() for p in parameters.values()):
+        raise ValueError("Nonfinite residual-head parameters")
+    if any(not mx.any(p != 0).item() for p in parameters.values()):
+        raise ValueError("Residual heads have not changed zero initialization")
+    _PARAMETERS = parameters
+    return parameters
+
+
+def _residual(parameters, z, embedding):
+    import mlx.core as mx
+    import mlx.nn as nn
+    u = mx.concatenate([z, embedding], axis=-1) @ parameters["A"].T + parameters["b"]
+    u = u.reshape(-1, 2, 576)
+    return z[:, None, :] + nn.silu(u)
+
+
+def propose(model, parameters, feature, token):
+    import mlx.core as mx
+    z = feature.reshape(1, 576)
+    embedding = model.model.embed_tokens(token.reshape(1)).reshape(1, 576)
+    rows = _residual(parameters, z, embedding).reshape(2, 576)
+    # A single two-row projection; no target KV writes or token host reads.
+    logits = model.model.embed_tokens.as_linear(rows)
+    return mx.argmax(logits, axis=-1).astype(token.dtype)
+
+
+
+def train():
+    from .train_residual import train as run
+    run()
+
+
+if __name__ == "__main__":
+    train()
