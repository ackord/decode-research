+                if case != "missing":
+                    artifact.write_bytes(rh.ROOT.joinpath("residual_heads.safetensors").read_bytes())
+                if case not in ("missing", "incomplete"):
+                    data = dict(valid)
+                    if case in ("untrained", "dtype", "shape", "nonfinite"):
+                        params = mx.load(str(artifact))
+                        if case == "untrained":
+                            params = {k: mx.zeros_like(v) for k, v in params.items()}
+                        elif case == "dtype":
+                            params["A"] = params["A"].astype(mx.float32)
+                        elif case == "shape":
+                            params["b"] = params["b"][:1]
+                        else:
+                            params["b"] = mx.full((1152,), float("nan"), dtype=mx.bfloat16)
+                        mx.save_safetensors(str(artifact), params)
+                    data["artifact_sha256"] = "bad" if case == "hash" else rh._sha(artifact)
+                    manifest.write_text(json.dumps(data))
+                try:
+                    ci.prefill(model, [1, 41, 58])
+                except (FileNotFoundError, ValueError):
+                    pass
+                else:
+                    raise AssertionError("Invalid artifact accepted: " + case)
+    predictor = ci.load_predictor(model)
+    assert predictor is not None, "Run python -m candidate.residual_heads before active checks"
+    modules = [(name, id(module)) for name, module in model.named_modules()]
+    parameters = [(name, value, mx.asarray(value, copy=True))
+                  for name, value in tree_flatten(model.parameters())]
+    prompt = [1] + [41 + (i * 17) % 311 for i in range(23)]
+    pending, base = ci.prefill(model, prompt)
+    assert base.feature_offset == len(prompt)
+
+    # Capture the actual native normalized output, including full prefill head
+    # shape, without changing the model object or its arithmetic.
+    captured = []
+    norm_call = nn.RMSNorm.__call__
+
+    def capture_norm(module, x):
+        result = norm_call(module, x)
+        if module is model.model.norm:
+            captured.append(result)
+        return result
+
+    native = make_prompt_cache(model)
+    with patch.object(nn.RMSNorm, "__call__", capture_norm):
+        native_logits = model(mx.array(prompt)[None], cache=native)
+    mx.eval(native_logits)
+    _equal(pending, mx.argmax(native_logits[:, -1, :], axis=-1), "native prefill token")
+    _equal(base.feature, captured[-1][:, -1:, :], "native prefill feature")
+    _prefixes(base, native, "native prefill KV")
+    candidate_cache = make_prompt_cache(model)
+    candidate_logits, candidate_feature = ci._native_forward(
+        model, mx.array(prompt)[None], candidate_cache, True)
+    _equal(candidate_logits, native_logits, "full prompt-shaped head")
+    _equal(candidate_feature, base.feature, "copied prompt feature")
+
+    # Independent singleton oracle, with actual target features for all output
+    # positions. The same target object remains usable by native reference.
+    reference = _clone(model, base, base[0].offset + 48)
+    token = pending
+    oracle, oracle_features = [pending.item()], [base.feature]
+    for _ in range(31):
+        captured.clear()
+        with patch.object(nn.RMSNorm, "__call__", capture_norm):
+            logits = model(token.reshape(1, 1), cache=reference)
+        token = mx.argmax(logits[:, -1, :], axis=-1)
+        mx.eval(token, captured[-1])
+        oracle.append(token.item())
+        oracle_features.append(mx.asarray(captured[-1], copy=True))
+
+    # Every verifier branch exposes native normalized rows. Features must not
