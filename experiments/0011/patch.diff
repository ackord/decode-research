+    def preorder(self):
+        order = []
+        stack = [0]
+        while stack:
+            node = stack.pop()
+            order.append(node)
+            # Children are selected in priority order. LIFO visits weak first.
+            stack.extend(self.children[node])
+        return order
+
+    def path(self, node):
+        path = []
+        while node is not None:
+            path.append(node)
+            node = self.parents[node]
+        return path[::-1]
