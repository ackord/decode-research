+def _attention_counts(cache, start, m, layers=1):
+    fragments = ci._attention_fragments(start, m)
+    grouped = sum(3 for lo, hi in fragments if hi - lo > 3)
+    scalar = sum(hi - lo for lo, hi in fragments if hi - lo <= 3)
+    assert cache.stats["grouped_attention_calls"] == layers * grouped
