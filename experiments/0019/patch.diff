+def _attention_supported(model, cache):
+    """Independent gate for the audited BF16 singleton attention entrypoints."""
+    return (version("mlx") == "0.32.3" and version("mlx-lm") == "0.32.0"
+            and mx.default_device() == mx.gpu
+            and _grouped_supported(model, cache) and _rotary_supported(model)
+            and all(type(kv) is KVCache for kv in cache)
+            and all(not layer.use_sliding and layer.self_attn.head_dim == 64
+                    and getattr(layer.self_attn, "sinks", None) is None
+                    for layer in model.layers))
+
