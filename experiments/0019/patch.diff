+def _attention_fragments(start, count):
+    """Preserve scalar dispatch regions and signed mask-index arithmetic."""
+    if start < 0 or start + count > 2147483647:
+        return None
+    cuts = {0, count}
+    for boundary in (1024, 4096):
+        # First position whose inclusive prefix is at least boundary.
+        cuts.add(max(0, min(count, boundary - start - 1)))
+    cuts = sorted(cuts)
+    fragments = list(zip(cuts, cuts[1:]))
+    if any(3 * (hi - lo) * (start + hi) > 2147483647
+           for lo, hi in fragments if hi - lo > 3):
+        return None
+    return fragments
+
+
+def _attention_masks(start, fragments):
+    masks = []
+    for lo, hi in fragments:
+        r, n = hi - lo, start + hi
+        if r > 3:
+            ends = (mx.arange(r, dtype=mx.int32) + start + lo + 1)
+            positions = mx.arange(n, dtype=mx.int32)[None, None, None, :]
+            valid = positions < ends[:, None, None, None]
+            # Materialize head expansion once, reused across heads and layers.
+            mask = mx.contiguous(mx.broadcast_to(valid, (r, 3, 1, n)))
+        else:
+            mask = None
+        masks.append((lo, hi, mask))
+    return masks
+
+
+def _shared_attention(q, kv, scale, start, fragments, stats):
+    """Pack only queries; K/V stay immutable broadcast views of allocated KV."""
+    outputs = []
+    buffers = [kv.keys, kv.values]
+    for lo, hi, mask in fragments:
+        r, n = hi - lo, start + hi
+        if mask is None:
+            for i in range(lo, hi):
+                deps = buffers + outputs[-1:]
+                out = llama.scaled_dot_product_attention(
+                    mx.depends(q[i:i + 1], deps),
+                    kv.keys[..., :start + i + 1, :],
+                    kv.values[..., :start + i + 1, :],
+                    cache=kv, scale=scale, mask=None)
+                outputs.append(out.transpose(0, 2, 1, 3).reshape(1, 1, 576))
+                stats["singleton_attention_calls"] += 1
+        else:
+            heads = []
+            for h in range(3):
+                queries = mx.contiguous(q[lo:hi, 3 * h:3 * h + 3])
+                keys = mx.broadcast_to(kv.keys[:, h:h + 1, :n, :], (r, 1, n, 64))
+                values = mx.broadcast_to(kv.values[:, h:h + 1, :n, :], (r, 1, n, 64))
+                out = llama.scaled_dot_product_attention(
+                    mx.depends(queries, buffers + outputs[-1:] + heads[-1:]),
+                    keys, values, cache=kv, scale=scale, mask=mask)
+                heads.append(out)
+                stats["grouped_attention_calls"] += 1
+            outputs.append(mx.concatenate(heads, axis=1).reshape(1, r, 576))
+    return mx.concatenate(outputs, axis=1)
+
