+def _prepare_pairs(model, cache):
+    """Weight-only preparation; materialize request-local banks before decode."""
+    if not _pair_runtime_supported() or not _grouped_supported(model, cache):
+        return
+    started = perf_counter()
+    banks = tuple((mx.contiguous(mx.stack([layer.self_attn.k_proj.weight,
+                                          layer.self_attn.v_proj.weight])),
+                   mx.contiguous(mx.stack([layer.mlp.gate_proj.weight,
+                                          layer.mlp.up_proj.weight])))
+                  for layer in model.layers)
+    mx.eval(*(bank for pair in banks for bank in pair))
+    valid = True
+    for pair in banks:
+        for bank, n in zip(pair, (192, 1536)):
+            valid = valid and bank.shape == (2, n, 576) and bank.dtype == mx.bfloat16
+            # Inspect only prepared weight storage, never generated activations.
+            with memoryview(bank) as view:
+                valid = valid and view.strides == (n * 576 * 2, 1152, 2)
+    if valid:
+        cache.pair_banks = banks
+        cache.pair_layouts_valid = True
+        cache.pair_bank_ids = tuple(tuple(id(bank) for bank in pair) for pair in banks)
+        cache.stats["pair_bank_bytes"] = sum(bank.nbytes for pair in banks for bank in pair)
+    cache.stats["pair_preparation_seconds"] = perf_counter() - started
+
+
+def _pair_supported(model, cache):
+    """Preflight every bank before any verifier cache mutation."""
+    banks = cache.pair_banks
+    return (_pair_runtime_supported()
+            and (cache.grouped_eligible if cache.grouped_eligible is not None
+                 else _grouped_supported(model, cache))
+            and cache.pair_layouts_valid and banks is not None
+            and len(banks) == len(model.layers)
+            and tuple(tuple(id(bank) for bank in pair) for pair in banks) == cache.pair_bank_ids
+            and all(len(pair) == 2 and all(bank.shape == (2, n, 576)
+                    and bank.dtype == mx.bfloat16
+                    for bank, n in zip(pair, (192, 1536))) for pair in banks))
+
+
+def _paired_project(bank, block, dependencies, lhs_indices, rhs_indices):
+    """Two unchanged-width singleton products, ordered by sibling then position."""
+    m, k = block.shape[1:]
+    x = mx.depends(mx.contiguous(block), dependencies).reshape(m, 1, k)
+    # Preserve the column-major matrix view; never copy this transpose.
+    result = mx.gather_mm(x, bank.transpose(0, 2, 1),
+                          lhs_indices=lhs_indices, rhs_indices=rhs_indices,
+                          sorted_indices=False).reshape(2, m, bank.shape[1])
+    return result[0:1], result[1:2], result
